# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 Git에 올라가지 않습니다.

# OpenAI 키 또는 SSAFY GMS 키. GMS 안내처럼 GMS_KEY 라는 이름으로 넣어도 됩니다.
OPENAI_API_KEY=
# GMS_KEY=

# SSAFY GMS 를 쓸 때의 주소. OpenAI 를 직접 쓰면 이 줄을 비워 둡니다.
OPENAI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1

# 위키백과 User-Agent 정책상 연락 가능한 이메일 또는 URL
WIKI_CONTACT=

# (선택) LangSmith 추적
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=f1-rag

# (선택) 개발용: API 키 없이 화면만 확인할 때 1. 실제 답변이 아니라 가짜 모델 응답이 나옵니다.
# F1RAG_FAKE_MODELS=1
